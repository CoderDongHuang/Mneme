{
  "version": 1,
  "$defs": {
    "KnowledgeBase": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "userId": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, { "type": "null" }] },
        "name": { "type": "string", "minLength": 1 },
        "description": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "chromaCollectionId": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "status": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "createdAt": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "updatedAt": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "KnowledgeBaseList": {
      "type": "array",
      "items": { "$ref": "#/$defs/KnowledgeBase" }
    },
    "KnowledgeBaseDeletionReceipt": {
      "type": "object",
      "required": ["deleted"],
      "properties": {
        "deleted": { "const": true }
      }
    }
  }
}
