{
  "version": 1,
  "$defs": {
    "Quiz": {
      "type": "object",
      "required": [
        "id",
        "title",
        "questions_json"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "questions_json": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/QuizQuestion"
              }
            }
          ]
        },
        "kb_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "topic": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        }
      }
    },
    "QuizQuestion": {
      "type": "object",
      "required": [
        "type",
        "prompt"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "type": {
          "enum": [
            "short",
            "choice"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/QuizOption"
              }
            ]
          }
        },
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "QuizOption": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "label": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "value": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "key": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "label"
          ],
          "properties": {
            "text": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "label": {
              "type": "string"
            },
            "value": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "key": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    },
    "QuizDraft": {
      "type": "object",
      "required": [
        "answers_json",
        "current_question"
      ],
      "properties": {
        "answers_json": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "current_question": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at": {
          "type": "string"
        }
      }
    },
    "SaveQuizDraftRequest": {
      "type": "object",
      "properties": {
        "answers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "current_question": {
          "type": "integer"
        }
      }
    },
    "QuizFeedback": {
      "type": "object",
      "required": [
        "correct",
        "expected",
        "evidence"
      ],
      "properties": {
        "question_id": {
          "type": "integer"
        },
        "correct": {
          "type": "boolean"
        },
        "expected": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "covered_key_points": {
          "type": "integer"
        },
        "key_point_count": {
          "type": "integer"
        },
        "source": {
          "type": "object",
          "properties": {
            "document_id": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "page": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "QuizAttempt": {
      "type": "object",
      "required": [
        "id",
        "answers_json",
        "score",
        "feedback_json",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "answers_json": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "raw_score": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "feedback_json": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/QuizFeedback"
              }
            }
          ]
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SubmitQuizRequest": {
      "type": "object",
      "properties": {
        "answers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64
        }
      }
    },
    "QuizSubmissionReceipt": {
      "type": "object",
      "required": [
        "score",
        "feedback"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "raw_score": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "feedback": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuizFeedback"
          }
        }
      }
    },
    "ReportQuestionRequest": {
      "type": "object",
      "required": [
        "question",
        "reason"
      ],
      "properties": {
        "question": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "ReportQuestionReceipt": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "recorded"
        }
      }
    }
  }
}
