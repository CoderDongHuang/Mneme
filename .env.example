# Model providers
DEEPSEEK_API_KEY=sk-your-deepseek-key
DASHSCOPE_API_KEY=sk-your-dashscope-key
DEEPSEEK_MODEL=deepseek-chat
EMBEDDING_MODEL=text-embedding-v3
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_MODEL=qwen-plus
LLM_CIRCUIT_BREAKER_THRESHOLD=3
LLM_CIRCUIT_RECOVERY_SECONDS=60
LLM_STREAM_TIMEOUT_SECONDS=20
LLM_HOURLY_LIMIT=1000
# CI acceptance only. Never enable this deterministic model in production.
MNEME_DETERMINISTIC_TEST_LLM=false
MNEME_OFFLINE_EMBEDDINGS=false

# Chroma: local uses python-agent/data/chroma; http uses host/port
CHROMA_MODE=local
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Redis is optional for Python and Java
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
SESSION_TTL_HOURS=24
NOTIFICATION_REDIS_ENABLED=false

# Memory and retrieval
WORKING_MEMORY_WINDOW_SIZE=12
WORKING_MEMORY_MAX_TOKENS=5000
RETRIEVER_TOP_K=6
RETRIEVER_CONTEXT_MAX_CHARS=12000
DISTILLATION_IDLE_MINUTES=15
MEMORY_REFLECTION_EVERY_SESSIONS=5

# Document ingestion
UPLOAD_MAX_MB=30
OCR_ENABLED=true
OCR_LANGUAGES=chi_sim+eng
PDF_MIN_TEXT_CHARS=80
# Optional: analyzes embedded diagrams/images and consumes DashScope quota.
MULTIMODAL_ENABLED=false
MULTIMODAL_MODEL=qwen-vl-plus
MULTIMODAL_MAX_IMAGES=8
# Optional ClamAV INSTREAM scanning. Use fail-closed in production.
MALWARE_SCAN_ENABLED=false
MALWARE_SCAN_FAIL_CLOSED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=5000

# Java Gateway
MYSQL_ROOT_PASSWORD=replace-with-a-strong-database-password
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/mneme?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root
PYTHON_AGENT_URL=http://localhost:8001
JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_SERVICE_TOKEN=replace-with-a-separate-random-service-token
INTERNAL_SERVICE_TOKEN_PREVIOUS=
STORAGE_BACKEND=local
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=mneme
TENANT_STORAGE_QUOTA_MB=2048
TENANT_KNOWLEDGE_BASE_QUOTA=100
RERANKER_ENABLED=false
RERANKER_PROVIDER=dashscope
RERANKER_MODEL=gte-rerank-v2
SECURE_COOKIES=false
JWT_EXPIRATION=86400000
FILE_STORAGE_PATH=../data/files
AVATAR_STORAGE_PATH=../data/avatars
OBJECT_BACKUP_URI=s3://your-private-backup-bucket/mneme
ADMIN_API_TOKEN=replace-with-a-separate-32-byte-admin-token
PASSWORD_RESET_FROM=mneme@local.test
# Docker self-hosting uses the built-in Mailpit service.
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false

# Runtime
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PUBLIC_ORIGIN=localhost
PUBLIC_DOMAIN=localhost
LOG_LEVEL=INFO

# Optional OpenTelemetry export. Leave empty to disable Python export.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=mneme-python-agent
OTEL_TRACES_SAMPLER_ARG=0.1
