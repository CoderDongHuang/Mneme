# Model providers
# Offline demonstration only; scripts/demo.py supplies its isolated configuration.
# Keep false for normal deployments. Demo provides excerpts, not generated answers.
MNEME_DEMO_MODE=false
DEEPSEEK_API_KEY=sk-your-deepseek-key
DASHSCOPE_API_KEY=sk-your-dashscope-key
DEEPSEEK_MODEL=deepseek-chat
EMBEDDING_MODEL=text-embedding-v3
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_MODEL=qwen-plus
LLM_CIRCUIT_BREAKER_THRESHOLD=3
LLM_CIRCUIT_RECOVERY_SECONDS=60
LLM_STREAM_TIMEOUT_SECONDS=20
LLM_HOURLY_LIMIT=1000
LLM_DAILY_BUDGET_USD=0
LLM_PRIMARY_INPUT_COST_PER_MILLION=0
LLM_PRIMARY_OUTPUT_COST_PER_MILLION=0
LLM_FALLBACK_INPUT_COST_PER_MILLION=0
LLM_FALLBACK_OUTPUT_COST_PER_MILLION=0
LLM_DEFAULT_MAX_OUTPUT_TOKENS=1024
# CI acceptance only. Never enable this deterministic model in production.
MNEME_DETERMINISTIC_TEST_LLM=false
MNEME_OFFLINE_EMBEDDINGS=false

# Qdrant: local uses python-agent/data/qdrant; http uses an explicit URL
VECTOR_STORE_MODE=local
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# QDRANT_PATH=python-agent/data/qdrant

# Redis is required for complete self-hosted workflows and reflection queue recovery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Empty only for local development/selfhost/demo. Production Compose requires a password.
REDIS_PASSWORD=
SESSION_TTL_HOURS=24
NOTIFICATION_REDIS_ENABLED=false
AUXILIARY_STORE_BACKEND=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=mneme
MYSQL_USER=root
MYSQL_PASSWORD=

# Memory and retrieval
WORKING_MEMORY_WINDOW_SIZE=12
WORKING_MEMORY_MAX_TOKENS=5000
RETRIEVER_REWRITE_ENABLED=true
# Conservative Chinese concrete-noun check; disable for synonym-heavy corpora.
# This lexical heuristic does not replace answer-level evidence verification.
RETRIEVER_FOCUS_GATE_ENABLED=true
RETRIEVER_TOP_K=6
RETRIEVER_CONTEXT_MAX_CHARS=12000
DISTILLATION_IDLE_MINUTES=15
MEMORY_REFLECTION_EVERY_SESSIONS=5

# Document ingestion
UPLOAD_MAX_MB=30
OCR_ENABLED=true
OCR_LANGUAGES=chi_sim+eng
PDF_MIN_TEXT_CHARS=80
# Optional: analyzes embedded diagrams/images and consumes DashScope quota.
MULTIMODAL_ENABLED=false
MULTIMODAL_MODEL=qwen3-vl-plus
MULTIMODAL_MAX_IMAGES=8
# Optional ClamAV INSTREAM scanning. Use fail-closed in production.
MALWARE_SCAN_ENABLED=false
MALWARE_SCAN_FAIL_CLOSED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=5000

# Java Gateway
MYSQL_ROOT_PASSWORD=replace-with-a-strong-database-password
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/mneme?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root
PYTHON_AGENT_URL=http://localhost:8001
JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_SERVICE_TOKEN=replace-with-a-separate-random-service-token
INTERNAL_SERVICE_TOKEN_PREVIOUS=
STORAGE_BACKEND=local
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=mneme
TENANT_STORAGE_QUOTA_MB=2048
TENANT_KNOWLEDGE_BASE_QUOTA=100
RERANKER_ENABLED=false
RERANKER_PROVIDER=dashscope
RERANKER_MODEL=gte-rerank-v2
RERANKER_MIN_SCORE=0
SECURE_COOKIES=false
JWT_EXPIRATION=86400000
JWT_REMEMBER_EXPIRATION=2592000000
FILE_STORAGE_PATH=../data/files
AVATAR_STORAGE_PATH=../data/avatars
OBJECT_BACKUP_URI=s3://your-private-backup-bucket/mneme
ADMIN_API_TOKEN=replace-with-a-separate-32-byte-admin-token
RECOVERY_GITHUB_REPOSITORY=
RECOVERY_GITHUB_TOKEN=
RECOVERY_WORKER_URL=
# Run scripts/recovery_worker.py on the Docker host; use a unique 32+ character token.
RECOVERY_WORKER_TOKEN=
# Production requires an independent stable key (>=32 characters), unequal to JWT_SECRET.
# JWT fallback is permitted only in explicitly non-production installations.
MODEL_CONFIG_ENCRYPTION_KEY=
MODEL_CONFIG_KEY_VERSION=v2
# JSON keyring from a secret manager. Never commit actual previous keys.
# For pre-V25 rows, explicitly map legacy-v1 to their ORIGINAL encryption key.
MODEL_CONFIG_PREVIOUS_KEYS={}
PROMETHEUS_URL=
AGENT_TOOL_DAILY_QUOTA=1000
AGENT_TOOL_APPROVAL_TTL_SECONDS=3600
PASSWORD_RESET_FROM=
# Production SMTP. docker-compose.selfhost.yml explicitly uses its own Mailpit.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Runtime
# Production release images: use a unique release tag or, preferably, @sha256 digest.
# Build and publish these images in the release pipeline before deploying with --no-build.
MNEME_PYTHON_IMAGE=
MNEME_JAVA_IMAGE=
MNEME_FRONTEND_IMAGE=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TRUSTED_PROXIES=172.16.0.0/12
PUBLIC_ORIGIN=localhost
PUBLIC_DOMAIN=localhost
LOG_LEVEL=INFO

# Optional OpenTelemetry export. Leave empty to disable Python export.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=mneme-python-agent
OTEL_TRACES_SAMPLER_ARG=0.1

# Alertmanager must be pointed at an authenticated notification gateway.
ALERTMANAGER_WEBHOOK_URL=https://alerts.example.invalid/mneme

# Backup protection. Set both in production and rotate BACKUP_KEY_VERSION together.
BACKUP_ENCRYPTION_KEY=replace-with-a-random-32-byte-secret
BACKUP_SIGNING_KEY=replace-with-a-separate-random-32-byte-secret
BACKUP_KEY_VERSION=v1
BACKUP_REQUIRE_PROTECTION=true
# Optional production envelope encryption adapter. It receives `wrap|unwrap VERSION`
# and base64 data on stdin, and must return base64 on stdout. Keep the provider outside
# the application container when possible; the local Python adapter is drill-only.
BACKUP_KMS_COMMAND=
BACKUP_KEY_PROVIDER=external-command
# AWS example: BACKUP_KMS_COMMAND="python scripts/backup_aws_kms.py"
# BACKUP_KMS_KEY_ID_V1=arn:aws:kms:REGION:ACCOUNT:key/UUID
# BACKUP_GEO_COPY_COMMAND=your-verified-secondary-region-copy-command
